#!/bin/sh
#
# Start the network....
#

case "$1" in
  start)
	printf "Starting network: "
	/sbin/ifup -a
	if ip route get 1 2>&1 | grep -iq "unreachable"; then
		/sbin/dhcpcd --noipv4ll -w -t 180
	fi
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  stop)
	printf "Stopping network: "
	/sbin/dhcpcd -k
	/sbin/ifdown lo
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  restart|reload)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?

